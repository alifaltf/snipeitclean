# Copy this file to a location OUTSIDE this repo (e.g. connector.env in a
# separate secrets folder) and fill in real values there. Never fill in
# real values in this file, and never commit a filled-in copy anywhere.

# --- Snipe-IT ---
SNIPEIT_BASE_URL=http://localhost:8000
SNIPEIT_API_TOKEN=replace-with-a-snipeit-personal-access-token

# --- Google Sheets (service account) ---
# Path to a service-account JSON key file. Keep this file outside the repo too.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
GOOGLE_SPREADSHEET_ID=replace-with-the-spreadsheet-id
GOOGLE_SHEET_NAME=Sheet1

# --- Safety switch ---
# Phase 1 only supports "dry-run" — the connector refuses to start with
# anything else, and there is no create/update/delete code path anyway.
SYNC_MODE=dry-run
